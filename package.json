{
  "name": "stockscan-tw",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Node server + Vue app: Taiwan (TWSE) listed companies' financial reports from MOPS Inline XBRL, with ratios, scores, a screener and valuation",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "build:web": "npm --prefix web run build",
    "postinstall": "npm --prefix web install",
    "build:static": "node server/tools/build-static.mjs",
    "data:pull": "sh scripts/pull-data.sh",
    "fetch:new": "node server/tools/fetch-new.mjs",
    "rescore": "node server/tools/rescore.mjs",
    "fetch:bars": "node server/tools/fetch-bars.mjs",
    "train:zdict": "node server/tools/train-zdict.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stoqey/ib": "^1.6.9",
    "cheerio": "^1.0.0",
    "express": "^4.21.0"
  }
}
